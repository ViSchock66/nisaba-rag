# Nisaba RAG — environment variables
#
# Copy this file to `.env` and adjust. `.env` is gitignored.
# Every variable is optional: the defaults work against a local Ollama.

# ── Embeddings ────────────────────────────────────────────────────────
# Model served by the local embedding endpoint.
NISABA_EMBED_MODEL=bge-m3
# Declared vector size. It must match what the model actually returns;
# `nisaba-rag doctor` reports a mismatch rather than letting the index fill
# with vectors that cannot be compared against new queries.
NISABA_EMBED_DIMS=1024
# Base URL of the embedding server (Ollama-compatible).
NISABA_OLLAMA_URL=http://127.0.0.1:11434
# Optional second-tier provider: any OpenAI-compatible /v1/embeddings API.
# Only used when set; leave empty to stay fully local.
NISABA_API_KEY=

# ── Storage ───────────────────────────────────────────────────────────
# Where chroma/ and index.sqlite live (defaults to ./data).
NISABA_DATA_DIR=
# Collection name inside the vector store.
NISABA_COLLECTION=documents
# Project root; relative paths in config.json resolve against it.
NISABA_HOME=

# ── Configuration file ────────────────────────────────────────────────
# Point at a config.json outside the checkout.
NISABA_CONFIG=

# ── Reranker (optional) ───────────────────────────────────────────────
# Folder holding the exported cross-encoder (model.onnx + tokenizer.json).
NISABA_RERANKER_DIR=
# Execution provider: cpu (default), dml, cuda, coreml.
NISABA_RERANKER_PROVIDER=cpu
